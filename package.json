{
	"name": "sveltekit-minimalist-template",
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PaulioRandall/sveltekit-minimalist-template.git"
	},
	"scripts": {
		"update": "npx npm-check-updates -u && npm i",
		"clean": "rm -rf .svelte-kit",
		"fmt": "prettier --log-level warn --write .",
		"build": "npm run fmt && vite build",
		"dev": "npm run fmt && vite dev --port 3000",
		"preview": "npm run build && vite preview --port 4000",
		"audit": "npm run build && cat ./ready-to-integrate.txt"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.70.2",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.8",
		"vite": "8.2.0"
	}
}
